{
 "patterns": [
  {
   "key": "bento_grid",
   "name": "Bento 网格",
   "ref": "Apple / shadcn Bento Grid",
   "license": "pattern(自研实现)",
   "roles": [
    "features",
    "custom",
    "proof"
   ],
   "tags": [
    "bento",
    "网格",
    "卖点",
    "能力",
    "亮点",
    "九宫格"
   ],
   "fields": [
    {
     "key": "title",
     "label": "标题",
     "type": "text"
    },
    {
     "key": "lead",
     "label": "说明",
     "type": "textarea"
    },
    {
     "key": "items",
     "label": "格子",
     "type": "list",
     "itemFields": [
      {
       "key": "kicker",
       "label": "小标签",
       "type": "text"
      },
      {
       "key": "text",
       "label": "标题",
       "type": "text"
      },
      {
       "key": "desc",
       "label": "说明",
       "type": "text"
      },
      {
       "key": "span",
       "label": "占位(wide)",
       "type": "text"
      }
     ]
    }
   ],
   "template": "<div class=\"wb-inner\"><h2 style=\"margin:0 0 6px;font-size:1.5em\">{{title}}</h2><p style=\"margin:0 0 16px;color:var(--wf-muted)\">{{lead}}</p><div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:12px\">{{#items}}<div style=\"grid-column:span 2;padding:18px;border-radius:calc(var(--wf-radius,14px));border:1px solid var(--wf-border);background:var(--wf-surface);display:grid;gap:6px\"><span style=\"font-size:.76em;font-weight:700;letter-spacing:.08em;color:var(--wf-primary);text-transform:uppercase\">{{kicker}}</span><strong style=\"font-size:1.05em\">{{text}}</strong><span style=\"color:var(--wf-muted);font-size:.92em\">{{desc}}</span></div>{{/items}}</div></div>"
  },
  {
